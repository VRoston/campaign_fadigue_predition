# Example environment file. Copy to `.env` and edit paths for your environment.
# cp .env.example .env
# Then: source .env && streamlit run app/main.py

# Path to directory or glob with parquet files (required)
# export CAMPAIGN_DATA_PATH=/path/to/raw_campaigns

# Root directory that contains per-campaign model folders (optional)
# export CAMPAIGN_MODEL_ROOT=/path/to/models

# Single model file (optional, alternative to CAMPAIGN_MODEL_ROOT)
# export CAMPAIGN_MODEL_PATH=/path/to/xgb_alert_model.joblib

# Destination for analysis results (CSV + JSON)
# export CAMPAIGN_RESULT_PATH=/path/to/result_campaigns

# Optional: override default alert threshold (float)
# export ALERT_THRESHOLD=0.5
