# Example environment file. Copy to `.env` and edit paths for your environment.
# cp .env.example .env
# Then: source .env && streamlit run app/main.py

# Path to directory with parquet files (required)
export CAMPAIGN_DATA_PATH=/path/to/raw_campaigns

# Path to model file (required for campaign analysis)
# Default: ../models/v4_lagged/lgbm_fatigue_v4.joblib
# export CAMPAIGN_MODEL_PATH=/path/to/lgbm_fatigue_v4.joblib

# Path to model root (for finding model_summary.json)
# Default: ../models/v4_lagged/
# export CAMPAIGN_MODEL_ROOT=/path/to/models

# Alert threshold for fatigue risk (optional, default: 0.328)
export ALERT_THRESHOLD=0.328
